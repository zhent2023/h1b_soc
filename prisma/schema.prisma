generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DatasetVersion {
  id           String   @id @default(uuid()) @db.Uuid
  datasetName  String
  versionLabel String
  isActive     Boolean  @default(true)
  metaJson     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  oflcAreas         OflcArea[]
  oflcAreaCounties  OflcAreaCounty[]
  wageRates         WageRate[]
  socTitles         SocTitle[]
  onetSocMaps       OnetSocMap[]
  onetDuties        OnetDuty[]
  onetOccupations   OnetOccupation[]
  onetEmbeddingVersions OnetEmbeddingVersion[]
  geoCounties       GeoCounty[]
  geoCountyToCbsas  GeoCountyToCbsa[]
  geoCbsas          GeoCbsa[]
  geoCityCounties   GeoCityCounty[]
  skillCatalog      SkillCatalog[]
  occupationSkaRequirements OccupationSkaRequirement[]
  transcriptInferredSka TranscriptInferredSka[]

  @@index([datasetName])
}

enum TranscriptStatus {
  CREATED
  UPLOADED
  PARSING
  NEEDS_REVIEW
  READY
  FAILED
}

model AccessUser {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  keyHash   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email])
  @@index([isActive])
}

model User {
  id                   String   @id @default(uuid()) @db.Uuid
  email                String   @unique
  passwordHash         String
  fullName             String?
  lawFirm              String?
  isAttorneyConfirmed  Boolean  @default(false)
  marketingConsent     Boolean  @default(false)
  agreedAt             DateTime?
  agreedIp             String?
  marketingConsentAt   DateTime?
  marketingConsentIp   String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  sessions             Session[]
  transcripts          Transcript[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SkillCatalog {
  id               String   @id @default(uuid()) @db.Uuid
  datasetVersionId String   @db.Uuid
  skillId          String
  name             String
  description      String?
  taxonomyType     String
  embedding        Unsupported("vector(3072)")
  embeddingModelId String
  contentHash      String
  updatedAt        DateTime @updatedAt

  datasetVersion DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)

  @@unique([datasetVersionId, skillId])
  @@index([datasetVersionId])
}

model OccupationSkaRequirement {
  id               String  @id @default(uuid()) @db.Uuid
  datasetVersionId String  @db.Uuid
  onetCode         String
  skillId          String
  importance       Float?
  level            Float?
  reqWeight        Float

  datasetVersion DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)

  @@unique([datasetVersionId, onetCode, skillId])
  @@index([datasetVersionId, onetCode])
  @@index([datasetVersionId, skillId])
}

model CourseEmbeddingCache {
  courseTextHash   String   @id
  titleRaw         String
  embedding        Unsupported("vector(3072)")
  embeddingModelId String
  textPolicy       String
  updatedAt        DateTime @updatedAt
}

model Transcript {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @db.Uuid
  status          TranscriptStatus  @default(CREATED)
  sourceFileHash  String?
  parserProvider  String?
  parserVersion   String?
  parseConfidence Float?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  document  TranscriptDocument?
  courses   TranscriptCourse[]
  inferred  TranscriptInferredSka[]

  @@index([userId, createdAt])
}

model TranscriptDocument {
  transcriptId String   @id @db.Uuid
  storageUrl   String?
  deletedAt    DateTime?
  pageCount    Int?
  createdAt    DateTime @default(now())

  transcript Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
}

model TranscriptCourse {
  transcriptId String   @db.Uuid
  courseKey    String
  title        String
  credits      Float?
  grade        String?
  passStatus   String?
  summary      String?
  hasSkillEvidence Boolean?
  rawLine      String?
  isUserEdited Boolean  @default(false)
  createdAt    DateTime @default(now())

  transcript Transcript          @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  inferred   TranscriptInferredSka[]

  @@id([transcriptId, courseKey])
}

model TranscriptInferredSka {
  transcriptId     String   @db.Uuid
  courseKey        String
  skillId          String
  matchScore       Float
  skillWeight      Float
  embeddingModelId String
  datasetVersionId String   @db.Uuid
  createdAt        DateTime @default(now())

  transcript Transcript       @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  course     TranscriptCourse @relation(fields: [transcriptId, courseKey], references: [transcriptId, courseKey], onDelete: Cascade)
  datasetVersion DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)

  @@id([transcriptId, courseKey, skillId, embeddingModelId, datasetVersionId])
  @@index([transcriptId, skillId])
}

model OflcArea {
  id               String   @id @default(uuid()) @db.Uuid
  datasetVersionId String   @db.Uuid
  areaCode         String
  areaName         String
  stateAb          String?

  datasetVersion DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)
  counties       OflcAreaCounty[]
  wageRates      WageRate[]

  @@unique([datasetVersionId, areaCode])
  @@index([datasetVersionId, areaName])
}

model OflcAreaCounty {
  id                 String @id @default(uuid()) @db.Uuid
  datasetVersionId   String @db.Uuid
  areaCode           String
  countyFips         String
  stateAb            String
  countyTownName     String
  countyTownNameNorm String
  matchKind          String

  datasetVersion DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)
  area           OflcArea       @relation(fields: [datasetVersionId, areaCode], references: [datasetVersionId, areaCode], onDelete: Cascade)

  @@index([datasetVersionId, countyFips])
  @@index([datasetVersionId, stateAb, countyTownNameNorm, matchKind])
}

model WageRate {
  id                   String  @id @default(uuid()) @db.Uuid
  datasetVersionId     String  @db.Uuid
  wageYear             String
  isAcwia              Boolean @default(false)
  areaCode             String
  socCode              String
  l1Annual             Int
  l1Hourly             Decimal? @db.Decimal(10, 2)
  l2Annual             Int?
  l2Hourly             Decimal? @db.Decimal(10, 2)
  l3Annual             Int?
  l3Hourly             Decimal? @db.Decimal(10, 2)
  l4Annual             Int?
  l4Hourly             Decimal? @db.Decimal(10, 2)
  hasDataQualityIssue  Boolean @default(false)
  dataQualityNotes     Json?

  datasetVersion DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)
  area           OflcArea       @relation(fields: [datasetVersionId, areaCode], references: [datasetVersionId, areaCode], onDelete: Cascade)
  socTitle       SocTitle?      @relation(fields: [datasetVersionId, socCode], references: [datasetVersionId, socCode], onDelete: Cascade)

  @@unique([datasetVersionId, wageYear, isAcwia, areaCode, socCode])
  @@index([datasetVersionId, wageYear, isAcwia, socCode, l1Annual])
}

model SocTitle {
  id               String   @id @default(uuid()) @db.Uuid
  datasetVersionId String   @db.Uuid
  socCode          String
  title            String
  createdAt        DateTime @default(now())

  datasetVersion DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)
  wageRates      WageRate[]
  onetSocMaps    OnetSocMap[]

  @@unique([datasetVersionId, socCode])
  @@index([socCode])
}

model OnetSocMap {
  id               String @id @default(uuid()) @db.Uuid
  datasetVersionId String @db.Uuid
  onetCode         String
  socCode          String

  datasetVersion DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)
  socTitle       SocTitle       @relation(fields: [datasetVersionId, socCode], references: [datasetVersionId, socCode], onDelete: Cascade)

  @@unique([datasetVersionId, onetCode, socCode])
  @@index([datasetVersionId, socCode])
}

model OnetDuty {
  id               String   @id @default(uuid()) @db.Uuid
  datasetVersionId String   @db.Uuid
  onetCode         String
  dutyText         String
  dutyTextNorm     String
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  datasetVersion DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)

  @@index([datasetVersionId, onetCode])
  @@index([datasetVersionId, onetCode, sortOrder])
}

model OnetOccupation {
  id               String   @id @default(uuid()) @db.Uuid
  datasetVersionId String   @db.Uuid
  onetCode         String
  title            String
  jobZone          Int?
  createdAt        DateTime @default(now())

  datasetVersion DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)

  @@unique([datasetVersionId, onetCode])
  @@index([datasetVersionId, title])
}

model OnetEmbeddingVersion {
  id                   String   @id @default(uuid()) @db.Uuid
  provider             String
  model                String
  outputDim            Int
  onetDatasetVersionId String   @db.Uuid
  isActive             Boolean  @default(false)
  metaJson             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  datasetVersion DatasetVersion    @relation(fields: [onetDatasetVersionId], references: [id], onDelete: Cascade)
  embeddings     OnetDutyEmbedding[]

  @@index([onetDatasetVersionId])
  @@index([isActive])
}

model OnetDutyEmbedding {
  id                 String   @id @default(uuid()) @db.Uuid
  embeddingVersionId String   @db.Uuid
  onetCode           String
  contentText        String
  /// pgvector column; use raw SQL for vector similarity queries.
  embedding          Unsupported("vector(3072)")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  embeddingVersion OnetEmbeddingVersion @relation(fields: [embeddingVersionId], references: [id], onDelete: Cascade)

  @@unique([embeddingVersionId, onetCode])
  @@index([embeddingVersionId])
}

model GeoCityCounty {
  id               String  @id @default(uuid()) @db.Uuid
  datasetVersionId String  @db.Uuid
  stateAb          String
  cityName         String
  cityNameNorm     String
  countyName       String
  countyNameNorm   String
  countyFips       String?

  datasetVersion DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)

  @@unique([datasetVersionId, stateAb, cityNameNorm, countyNameNorm])
  @@index([datasetVersionId, stateAb, cityNameNorm])
  @@index([datasetVersionId, stateAb, countyNameNorm])
}

model GeoCounty {
  id               String @id @default(uuid()) @db.Uuid
  datasetVersionId String @db.Uuid
  countyFips       String
  stateAb          String
  countyName       String
  countyNameNorm   String

  datasetVersion DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)
  cbsaLinks      GeoCountyToCbsa[]

  @@unique([datasetVersionId, countyFips])
  @@index([datasetVersionId, stateAb, countyNameNorm])
}

model GeoCbsa {
  id               String  @id @default(uuid()) @db.Uuid
  datasetVersionId String  @db.Uuid
  cbsaCode         String
  cbsaName         String
  isMetropolitan   Boolean @default(true)

  datasetVersion DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)
  counties       GeoCountyToCbsa[]

  @@unique([datasetVersionId, cbsaCode])
}

model GeoCountyToCbsa {
  id               String @id @default(uuid()) @db.Uuid
  datasetVersionId String @db.Uuid
  countyFips       String
  cbsaCode         String

  datasetVersion DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)
  county         GeoCounty      @relation(fields: [datasetVersionId, countyFips], references: [datasetVersionId, countyFips], onDelete: Cascade)
  cbsa           GeoCbsa        @relation(fields: [datasetVersionId, cbsaCode], references: [datasetVersionId, cbsaCode], onDelete: Cascade)

  @@unique([datasetVersionId, countyFips, cbsaCode])
  @@index([datasetVersionId, cbsaCode])
}
