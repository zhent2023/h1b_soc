# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lca_tool

# Optional Redis (omit for in-memory)
REDIS_URL=

# Access control
ACCESS_MODE=invite  # invite | public
ACCESS_TOKEN_HEADER=x-access-key
ACCESS_EMAIL_HEADER=x-access-email

# Rate limits (per IP)
RATE_LIMIT_LOOKUP_PER_MIN=50
RATE_LIMIT_GEO_CANDIDATES_PER_MIN=120
RATE_LIMIT_SOC_EXTREMES_PER_MIN=30

# Geocoding
GEOCODER_PROVIDER=census # stub | census
GEOCODER_TIMEOUT_MS=5000
# Allow outbound to: geocoding.geo.census.gov

# Feature flags
FEATURE_TOWN_MATCHING=true
FEATURE_WAGE_QUALITY_BANNER=true
DUTY_SIMILARITY_THRESHOLD=0.85

# Dataset selection defaults
DEFAULT_WAGE_YEAR=2025-2026
DEFAULT_IS_ACWIA=false

# Debug tools (dev only)
ENABLE_DEBUG_TOOLS=false
ENABLE_DEBUG_HEADERS=false
