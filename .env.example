# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lca_tool

# Optional Redis (omit for in-memory)
REDIS_URL=

# Access control
ACCESS_MODE=invite  # invite | public
ACCESS_TOKEN_HEADER=x-access-key
ACCESS_EMAIL_HEADER=x-access-email

# Rate limits (per IP)
RATE_LIMIT_LOOKUP_PER_MIN=50
RATE_LIMIT_GEO_CANDIDATES_PER_MIN=120
RATE_LIMIT_SOC_EXTREMES_PER_MIN=30

# Geocoding
GEOCODER_PROVIDER=census # stub | census
GEOCODER_TIMEOUT_MS=5000
# Allow outbound to: geocoding.geo.census.gov

# Feature flags
FEATURE_TOWN_MATCHING=true
FEATURE_WAGE_QUALITY_BANNER=true
DUTY_SIMILARITY_THRESHOLD=0.85
FEATURE_SOC_RECOMMENDER=false
NEXT_PUBLIC_FEATURE_SOC_RECOMMENDER=false
FEATURE_SKILL_MATCHING=false
FEATURE_MATCH_FUSION=false
NEXT_PUBLIC_FEATURE_SKILL_MATCHING=false

# SOC recommender defaults
SOC_RECOMMEND_INTERNAL_TOPK=30
SOC_RECOMMEND_OUTPUT_TOPK=6
SOC_RECOMMEND_STATEMENT_TIMEOUT_MS=1500
SOC_RECOMMEND_ENRICHMENT_TIMEOUT_MS=300
SKILLS_DOMAIN_CANDIDATES=60
SKILLS_DOMAIN_BOOST=0.12

# Embeddings (fixed dimension: 3072)
EMBEDDING_PROVIDER=gemini # stub | gemini | openai-compatible
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_API_KEY=
EMBEDDING_API_URL=https://generativelanguage.googleapis.com/v1beta
WAGE_NATIONAL_AREA_CODE=

# Transcript uploads
TRANSCRIPT_MAX_BYTES=10485760
TRANSCRIPT_MIN_COURSE_COUNT=3
TRANSCRIPT_PARSER_MODEL=gemini-1.5-flash
TRANSCRIPT_OCR_MODEL=gemini-1.5-flash
TRANSCRIPT_PARSER_FALLBACK_MODEL=gemini-2.5-pro
TRANSCRIPT_OCR_FALLBACK_MODEL=gemini-2.5-pro
TRANSCRIPT_FALLBACK_MIN_CONFIDENCE=0.65
TRANSCRIPT_DELETE_AFTER_PARSE=true
STORAGE_PROVIDER=vercel_blob # vercel_blob | local
LOCAL_STORAGE_DIR=./.local/transcripts
BLOB_READ_WRITE_TOKEN=
ONET_DATA_DIR=./data/onet

# Dataset selection defaults
DEFAULT_WAGE_YEAR=2025-2026
DEFAULT_IS_ACWIA=false

# Debug tools (dev only)
ENABLE_DEBUG_TOOLS=false
ENABLE_DEBUG_HEADERS=false
